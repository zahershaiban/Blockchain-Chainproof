# ChainProof - Beispiel-Umgebungsvariablen.
# Kopiere diese Datei nach .env und passe die Werte an. .env wird NICHT committet.

# RPC-Endpunkt des Hardhat-Nodes (Default, falls nicht gesetzt: http://127.0.0.1:8545)
RPC_URL=http://127.0.0.1:8545

# Optional: Contract-Adresse ueberschreiben. Wenn leer/auskommentiert, wird sie
# aus artifacts/deployment-latest.json gelesen.
# CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# PRIVATE_KEY wird NUR vom Backend (register_model.py) zum Schreiben benoetigt.
# Das Frontend liest ausschliesslich und braucht KEINEN Private Key.
# PRIVATE_KEY=

# ChainProof model metadata
CHAINPROOF_MODEL_NAME=Health Risk Classifier
CHAINPROOF_MODEL_VERSION=1.0.0

# Dataset used to build the Merkle root
CHAINPROOF_DATASET_PATH=data/health_dataset_1000.csv
CHAINPROOF_DATASET_NAME=health_dataset_1000.csv

# Generated model/config artifacts
CHAINPROOF_MODEL_PATH=artifacts/model.pkl
CHAINPROOF_CONFIG_PATH=artifacts/config.json

# Output files
CHAINPROOF_HASHES_PATH=artifacts/hashes.json
CHAINPROOF_MERKLE_PATH=artifacts/dataset_merkle.json

# Example row used only to print one Merkle proof demo
CHAINPROOF_EXAMPLE_ROW_INDEX=1