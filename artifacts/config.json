{
    "project": "ChainProof",
    "model_name": "Health Risk Classifier",
    "version": "1.0.0",
    "dataset": "health_dataset_1000.csv",
    "target_column": "risk_level",
    "algorithm": "RandomForestClassifier",
    "n_estimators": 100,
    "random_state": 42,
    "test_size": 0.2,
    "accuracy": 0.81,
    "features": {
        "categorical": [
            "gender",
            "smoker",
            "family_history",
            "medication_adherence",
            "diagnosis"
        ],
        "numeric": [
            "age",
            "bmi",
            "systolic_bp",
            "diastolic_bp",
            "cholesterol_mg_dl",
            "glucose_mg_dl",
            "exercise_hours_week",
            "previous_hospitalizations"
        ]
    }
}